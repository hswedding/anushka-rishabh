// Cloudflare Workers config — static assets plus a tiny media Worker.
// Every couple's repo has its own copy: change `name` per couple. The name
// becomes the site URL: https://<name>.<your-subdomain>.workers.dev
// and must match the Worker name in the Cloudflare dashboard.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "anushka-rishabh",
  "compatibility_date": "2026-09-01",
  // Build first on every `wrangler deploy` / `wrangler dev`, so ./dist and
  // worker/media-sizes.json exist even when Cloudflare's dashboard has no
  // build command set (its deploy command alone would fail on a fresh clone).
  "build": { "command": "npm run build" },
  // Serve the site at https://<name>.<subdomain>.workers.dev — set explicitly,
  // since a Worker created by "Import a repository" can start with it off.
  "workers_dev": true,
  // Adds Range (206) support for films and music so Safari/iPhone can play them.
  "main": "worker/index.js",
  "assets": {
    // Vite's build output.
    "directory": "./dist",
    "binding": "ASSETS",
    // Unknown paths (the secret pages and guest links) fall back to index.html.
    "not_found_handling": "single-page-application",
    // Only media goes through the Worker; everything else is served directly.
    "run_worker_first": ["/videos/*", "/*.mp4", "/*.mp3", "/api/*"]
  },
  // Holds the RSVP sheet the builder saves. No id: `wrangler deploy` creates
  // the namespace on first deploy. Also needs the GOOGLE_SA_KEY secret
  // (README "RSVP sheet").
  "kv_namespaces": [{ "binding": "SETTINGS" }]
}
