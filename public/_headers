# Cloudflare static-asset headers (copied into dist/ by Vite, never served).
# Vite's /assets/* bundles carry a content hash in their name, so a changed
# file always gets a new URL — browsers can keep them for a year. Everything
# else keeps Cloudflare's default revalidation. Media paths go through
# worker/index.js, where these rules don't apply.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
